# Server
PORT=8787
WEB_ORIGIN=http://localhost:5173

# SQLite database file (dev fallback; production should mount a persistent volume)
DATABASE_PATH=./data/goodall.db

# Master key for encrypting integration credentials at rest (AES-256-GCM).
# MUST be a 32-byte value, base64 or hex encoded. Generate with:
#   openssl rand -base64 32
# Store this separately from the database (e.g. secrets manager) in production.
CREDENTIAL_ENCRYPTION_KEY=

# Optional dev fallback credentials. Prefer configuring these through the
# Integrations UI (encrypted server-side storage) instead of this file.
OPENAI_API_KEY=
FERGUS_API_KEY=
FERGUS_API_BASE_URL=https://api.fergus.com
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=http://localhost:8787/api/integrations/xero/callback
